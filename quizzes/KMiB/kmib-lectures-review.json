      "type": "matching",
      "question": {
        "mk": "Која верзија на HTTP што воведува?",
        "en": "What does each HTTP version introduce?"
      },
      "points": 3,
      "slots": [
        {
          "textBefore": {
            "mk": "Постојани врски по дифолт",
            "en": "Persistent connections by default"
          },
          "textAfter": "",
          "answer": "HTTP/1.1"
        },
        {
          "textBefore": {
            "mk": "Испреплетување (framing) на повеќе одговори врз една TCP врска",
            "en": "Interleaving (framing) several responses over one TCP connection"
          },
          "textAfter": "",
          "answer": "HTTP/2"
        },
        {
          "textBefore": {
            "mk": "Работи врз QUIC, кој работи врз UDP",
            "en": "Runs over QUIC, which runs over UDP"
          },
          "textAfter": "",
          "answer": "HTTP/3"
        }
      ],
      "bank": [
        "HTTP/1.1",
        "HTTP/2",
        "HTTP/3"
      ],
      "layout": "ordered"
    },
    {
      "type": "true_false",
      "question": {
        "mk": "Кај HTTP/3, загуба во еден QUIC тек не мора да го блокира доставувањето на друг, независен тек.",
        "en": "With HTTP/3, a loss in one QUIC stream doesn't have to block delivery of another, independent stream."
      },
      "points": 1,
      "answer": true
    },
