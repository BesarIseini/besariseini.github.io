    {
      "type": "single_choice",
      "question": {
        "mk": "Што е семплирање (sampling)?",
        "en": "What is sampling?"
      },
      "points": 1,
      "options": [
        {
          "text": {
            "mk": "Делење на хоризонталната оска (време) на дискретни делови – мерење во интервали",
            "en": "Dividing the horizontal axis (time) into discrete pieces – measuring at intervals"
          },
          "correct": true
        },
        {
          "text": {
            "mk": "Делење на вертикалната оска (јачина на сигналот) на нивоа",
            "en": "Dividing the vertical axis (signal strength) into levels"
          },
          "correct": false
        },
        {
          "text": {
            "mk": "Компресија на аудио фајл",
            "en": "Compressing an audio file"
          },
          "correct": false
        },
        {
          "text": {
            "mk": "Додавање метаподатоци",
            "en": "Adding metadata"
          },
          "correct": false
        }
      ]
    },
